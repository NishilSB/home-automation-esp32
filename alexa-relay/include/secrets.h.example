#define WIFI_SSID   "YOUR_WIFI_SSID"
#define WIFI_PASS   "YOUR_WIFI_PASSWORD"

// 2. Sinric Pro credentials (from https://portal.sinric.pro -> Credentials)
#define APP_KEY     "YOUR_SINRIC_APP_KEY"
#define APP_SECRET  "YOUR_SINRIC_APP_SECRET"

// 3. Switch Device IDs (from https://portal.sinric.pro -> Devices -> Add 2 Switches)
